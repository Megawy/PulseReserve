# Copy to .env (scripts/dev.ps1 setup / scripts/dev.sh setup does this and generates the password).
# .env is git-ignored. These are development-only values; never reuse them elsewhere.
POSTGRES_DB=pulsereserve
POSTGRES_USER=pulsereserve
POSTGRES_PASSWORD=change-me-dev-only

# Host ports (change if they clash with other local projects). The database is NOT published to the host.
WEB_PORT=4200
API_PORT=5080

# ──────────────────────────────────────────────────────────────────────────────────────────────────────────────
# Real payment providers (OPTIONAL). Both are OFF by default and need no credentials for development or tests:
# in Development the built-in payment simulator is used instead (no real money, always labelled "simulated").
#
# Put REAL values only in your private, git-ignored .env, and use each provider's TEST/sandbox credentials here.
# Live credentials are accepted only when the API runs with ASPNETCORE_ENVIRONMENT=Production (sandbox credentials are
# refused there), and must be supplied by your deployment's secret store, never committed. See
# docs/architecture/16-multi-provider-payments.md for every setting and the webhook URLs to register.
#
# A provider that is enabled but incomplete is simply unavailable (the reasons are logged, never the values).
#
# The payment simulator and a real provider are ALTERNATIVES: the API refuses to start when both are enabled (the simulator
# confirms payments by itself and must never sit next to a real provider). Enabling Stripe or Paymob below therefore also needs:
#   SIMULATOR_ENABLED=false
# (the default is true, which keeps the simulator for development without any provider).
SIMULATOR_ENABLED=true

# Stripe (hosted Checkout). Test keys start sk_test_ / webhook signing secret starts whsec_.
STRIPE_ENABLED=false
STRIPE_MODE=Test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Currencies Stripe may be asked to charge (comma-separated ISO codes); nothing is charged until this is set.
STRIPE_ALLOWED_CURRENCIES=
# Public base URL of the web app (where the customer returns to), e.g. http://localhost:4200 in development.
STRIPE_RETURN_BASE_URL=http://localhost:4200

# Paymob (Unified Checkout redirect, Egypt). Keys come from the Paymob dashboard (test mode).
PAYMOB_ENABLED=false
PAYMOB_MODE=Test
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# Comma-separated card/wallet integration ids from the Paymob dashboard (must match the key mode).
PAYMOB_INTEGRATION_IDS=
PAYMOB_ALLOWED_CURRENCIES=EGP
PAYMOB_RETURN_BASE_URL=http://localhost:4200
# Public https base URL of THIS API as Paymob can reach it (callbacks go to <it>/api/webhooks/paymob).
PAYMOB_PUBLIC_API_BASE_URL=

# Real-time updates (SignalR hub /hubs/live, docs/architecture/28-real-time-architecture.md). Both are on by default.
# LIVE_ENABLED=false removes the hub: pages keep working with their normal refresh and say "Live updates off".
LIVE_ENABLED=true
# Closes expired seat holds proactively (every few seconds) so the end of a hold is announced; expiry stays correct without it.
HOLD_EXPIRY_ENABLED=true
